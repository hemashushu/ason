{
    // VS Code settings for excluding certain files and directories
    // They are hidden from the VS Code explorer and search
    "files.exclude": {
        "target": true
    },
    // Exclude settings for search, but not necessarily from the explorer
    "search.exclude": {
        "IGNORE": true,
        "target": true
    },
    "chat.tools.terminal.autoApprove": {
        "rustc": true,
        "cargo clippy": true,
        "rustfmt": true,
        "cargo fmt": true,
        "cargo build": true,
        "cargo test": true,
        "cargo run": true,
        "cargo check": true,
        "cargo doc": true
    }
}
